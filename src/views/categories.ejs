
<%- include('partials/header') %>

<main class="container content-section">
    <h1><%= title %></h1>

    <p>
        Explore service opportunities by category
        and discover how you can contribute.
    </p>

    <section class="card-grid categories-grid" aria-label="Service project categories">
        <article class="card">
            <div class="card-content">
                <h2>Environmental</h2>
                <p>
                    Protect nature and support
                    environmental sustainability.
                </p>
            </div>
        </article>

        <article class="card">
            <div class="card-content">
                <h2>Educational</h2>
                <p>
                    Support learning and educational
                    opportunities in the community.
                </p>
            </div>
        </article>

        <article class="card">
            <div class="card-content">
                <h2>Community Service</h2>
                <p>
                    Participate in projects that improve
                    the lives of community members.
                </p>
            </div>
        </article>

        <article class="card">
            <div class="card-content">
                <h2>Health and Wellness</h2>
                <p>
                    Promote healthier lives through
                    wellness and outreach initiatives.
                </p>
            </div>
        </article>
    </section>
</main>

<%- include('partials/footer') %>
