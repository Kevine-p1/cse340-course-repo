
<%- include('partials/header') %>

<main class="container content-section">
    <h1><%= title %></h1>
    <p>
        Meet the organizations working to make our
        communities better.
    </p>

    <section class="card-grid" aria-label="Partner organizations">
        <article class="card">
            <img
                src="/images/brightfuture-logo.png"
                alt="Bright Future organization logo"
            >
            <div class="card-content">
                <h2>Bright Future</h2>
                <p>
                    Supporting educational opportunities
                    and helping students succeed.
                </p>
            </div>
        </article>

        <article class="card">
            <img
                src="/images/greenharvest-logo.png"
                alt="Green Harvest organization logo"
            >
            <div class="card-content">
                <h2>Green Harvest</h2>
                <p>
                    Encouraging environmental protection
                    and sustainable community initiatives.
                </p>
            </div>
        </article>

        <article class="card">
            <img
                src="/images/unityserve-logo.png"
                alt="Unity Serve organization logo"
            >
            <div class="card-content">
                <h2>Unity Serve</h2>
                <p>
                    Bringing volunteers together to
                    strengthen local communities.
                </p>
            </div>
        </article>
    </section>
</main>

<%- include('partials/footer') %>
