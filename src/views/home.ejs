
<%- include('partials/header') %>

<main>
    <section class="hero">
        <div class="container">
            <h1><%= title %></h1>
            <h2>Welcome to the CSE 340 Service Network!</h2>
            <p>
                Our mission is to promote service across the
                world by connecting volunteers with service
                opportunities in their community.
            </p>
            <a class="button" href="/projects">
                Explore Service Projects
            </a>
        </div>
    </section>

    <section class="container content-section">
        <h2>Make a Difference</h2>
        <p>
            Find meaningful ways to support your community,
            connect with service organizations, and make
            a positive impact through volunteering.
        </p>

        <img
            class="main-logo"
            src="/images/cse340-service-network.png"
            alt="CSE 340 Service Network logo"
        >
    </section>
</main>

<%- include('partials/footer') %>
