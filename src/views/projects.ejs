
<%- include('partials/header') %>

<main class="container content-section">
    <h1><%= title %></h1>

    <p>
        Discover opportunities to serve and make
        a positive difference.
    </p>

    <section class="card-grid" aria-label="Service projects">
        <article class="card">
            <div class="card-content">
                <h2>Community Cleanup</h2>
                <p>
                    Join volunteers to clean public spaces
                    and protect the environment.
                </p>
            </div>
        </article>

        <article class="card">
            <div class="card-content">
                <h2>Student Mentorship</h2>
                <p>
                    Help students develop important skills
                    through education and mentorship.
                </p>
            </div>
        </article>

        <article class="card">
            <div class="card-content">
                <h2>Food Donation Drive</h2>
                <p>
                    Support families in need through
                    community food collection initiatives.
                </p>
            </div>
        </article>
    </section>
</main>

<%- include('partials/footer') %>
